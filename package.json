{
  "name": "test_js",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha test/**/*.test.js --reporter mochawesome",
    "coverage": "c8 --reporter=html --reporter=text npm test",
    "lint": "eslint . || exit 0",
    "lint:fix": "eslint . --fix || exit 0",
    "prepare": "[ -n \"$CI\" ] || husky"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "eslint": "^8.56.0",
    "eslint-formatter-codeframe": "^7.32.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.1.0",
    "mocha": "^11.1.0",
    "mochawesome": "^7.1.3",
    "prettier": "^3.5.3"
  },
  "mocha": {
    "reporter": "mochawesome",
    "reporter-options": {
      "reportDir": "./mochawesome-report",
      "quiet": true,
      "html": true,
      "json": true,
      "overwrite": true
    }
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "**/*.test.js"
    ],
    "reporter": [
      "html",
      "text"
    ],
    "check-coverage": true,
    "branches": 80,
    "lines": 80,
    "functions": 80,
    "statements": 80
  }
}

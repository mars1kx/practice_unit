{
  "name": "test_js",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha test/**/*.test.js --reporter mochawesome",
    "coverage": "c8 --reporter=html --reporter=text npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "mochawesome": "^7.1.3"
  },
  "mocha": {
    "reporter": "mochawesome",
    "reporter-options": {
      "reportDir": "./mochawesome-report",
      "quiet": true,
      "html": true,
      "json": true,
      "overwrite": true
    }
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "**/*.test.js"
    ],
    "reporter": [
      "html",
      "text"
    ],
    "check-coverage": true,
    "branches": 80,
    "lines": 80,
    "functions": 80,
    "statements": 80
  }
}
